# The canonical origin used for canonicals, the sitemap, robots.txt and OG
# images. Defaults to https://www.mwatchcollection.com when unset, so a fresh
# clone builds correctly without any .env file.
#
# Set it locally when you want the emitted URLs to point at the dev server:
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.mwatchcollection.com
