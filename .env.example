# The canonical origin used for canonicals, the sitemap, robots.txt and OG
# images. Defaults to https://www.mwatchcollection.com when unset, so a fresh
# clone builds correctly without any .env file.
#
# Set it locally when you want the emitted URLs to point at the dev server:
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.mwatchcollection.com

# Serve catalogue photos through our own /img route handler instead of straight
# from GitHub raw. Off unless set to exactly "true".
#
# Leave it off on Vercel's Hobby plan. The proxy is a Vercel Function, and every
# photo it serves without a CDN cache hit counts as Fast Origin Transfer (10 GB
# included). That got the team paused on 2026-11-15. When it is on, photos get a
# 30-day Cache-Control instead of GitHub raw's 5 minutes.
#
# Next inlines it at build time, so changing it needs a rebuild or a redeploy.
#   NEXT_PUBLIC_IMAGE_PROXY=true
