{
  "name": "m_watch_collection",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate-index": "tsx scripts/generate-collection-index.ts",
    "predev": "tsx scripts/generate-collection-index.ts",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev --turbopack",
    "prebuild": "tsx scripts/generate-collection-index.ts",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "analyze": "cross-env ANALYZE=true NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "prettier": "npx prettier --write .",
    "generate-pdf": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/generate-pdf-book.tsx"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "husky": "^9.1.7",
    "lucide-react": "^0.517.0",
    "next": "^16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-ga4": "^2.1.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "yet-another-react-lightbox": "^3.21.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@next/bundle-analyzer": "^16.2.0",
    "@playwright/test": "^1.62.1",
    "@react-pdf/renderer": "^4.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.0.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": "eslint --cache --fix",
    "*.{ts,tsx,mjs,js,json,css,md}": "prettier --write"
  }
}
